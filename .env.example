PORT=3000
DB_PATH=./data/promoflow.db

TELEGRAM_BOT_TOKEN=

WHATSAPP_ENABLED=true
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-por-uma-chave-forte
EVOLUTION_INSTANCE=promoflow

POSTGRES_PASSWORD=troque-por-outra-senha
# Mercado Livre (descoberta automática de produtos)
# Opção 1: access token pronto
ML_ACCESS_TOKEN=
# Opção 2: app do Mercado Livre (client credentials)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Categorias usadas na descoberta (separadas por vírgula)
ML_DISCOVERY_CATEGORIES=MLB1648,MLB1051,MLB1144,MLB1276,MLB1430,MLB1747,MLB1367,MLB1132

# URL pública HTTPS do PromoFlow (usada no redirect do OAuth do Mercado Livre)
# Ex.: https://algo-aleatorio.trycloudflare.com
PUBLIC_BASE_URL=
# Opcional: sobrescreve a URL de callback completa
ML_REDIRECT_URI=

# Fuso horário usado na janela de envios (8h às 21h)
TZ=America/Sao_Paulo
