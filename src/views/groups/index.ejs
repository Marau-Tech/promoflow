<div class="page-header"><div><h1>Grupos</h1><p class="muted">Conecte suas contas e escolha os grupos que receberão as promoções</p></div></div>

<div class="row">
  <div class="card grow" style="flex:1">
    <h3>🟢 WhatsApp</h3>
    <% if (!whatsappEnabled) { %>
      <p class="warn">Defina <code>WHATSAPP_ENABLED=true</code> no .env e reinicie o servidor.</p>
    <% } else if (whatsapp.status === 'ready') { %>
      <p><span class="pill ok">Conectado</span></p>
      <form method="POST" action="/grupos/whatsapp/sync" class="inline"><button class="btn btn-primary">🔄 Importar grupos</button></form>
      <form method="POST" action="/grupos/whatsapp/logout" class="inline"><button class="btn btn-light">Desconectar</button></form>
    <% } else if (whatsapp.status === 'qr') { %>
      <p>Escaneie com o WhatsApp (Aparelhos conectados):</p><img id="waQr" src="<%= whatsapp.qr %>" width="220">
    <% } else { %>
      <p class="muted">Iniciando cliente… aguarde o QR Code.</p>
    <% } %>
  </div>

  <div class="card grow" style="flex:1">
    <h3>🔵 Telegram</h3>
    <% if (!telegramConfigured) { %>
      <p class="warn">Defina <code>TELEGRAM_BOT_TOKEN</code> no .env (crie o bot no @BotFather).</p>
    <% } else { %>
      <p class="muted">Adicione o bot como administrador do grupo/canal, envie uma mensagem lá e clique em importar.</p>
      <form method="POST" action="/grupos/telegram/sync"><button class="btn btn-primary">🔄 Importar grupos</button></form>
      <details><summary class="muted small">Adicionar manualmente por chat_id</summary>
        <form method="POST" action="/grupos/telegram/manual" class="row">
          <div class="field grow"><input name="name" placeholder="Nome" required></div>
          <div class="field grow"><input name="external_id" placeholder="-1001234567890" required></div>
          <div class="field"><button class="btn btn-light">Adicionar</button></div>
        </form>
      </details>
    <% } %>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <h3 class="card-title">Grupos cadastrados</h3>
      <p class="muted small">Selecione os grupos na tabela para excluir vários de uma vez.</p>
    </div>
    <% if (groups.length) { %>
      <div class="actions-inline">
        <span class="badge" id="group-count">0 selecionados</span>
        <form id="bulk-delete-form" method="POST" action="/grupos/delete-selected"
              data-confirm="Excluir os grupos selecionados? Esta ação não pode ser desfeita."
              data-confirm-title="Excluir grupos"
              data-confirm-text="Excluir"
              data-confirm-danger="true">
          <button class="btn btn-danger" id="btn-delete-selected" type="submit" disabled>🗑️ Excluir selecionados</button>
        </form>
      </div>
    <% } %>
  </div>
  <% if (!groups.length) { %><div class="empty">👥<p>Nenhum grupo importado ainda.</p></div><% } else { %>
  <table>
    <thead><tr><th class="group-check-col"><input type="checkbox" id="group-all" aria-label="Selecionar todos"></th><th>Plataforma</th><th>Nome</th><th>ID</th><th>Ativo para envio</th><th class="text-right">Ações</th></tr></thead>
    <tbody>
      <% groups.forEach(g => { %>
        <tr>
          <td class="group-check-col"><input type="checkbox" class="group-check" name="ids" value="<%= g.id %>" form="bulk-delete-form" aria-label="Selecionar grupo <%= g.name %>"></td>
          <td><%= g.platform === 'whatsapp' ? '🟢 WhatsApp' : '🔵 Telegram' %></td>
          <td><%= g.name %></td>
          <td class="muted small"><%= g.external_id %></td>
          <td>
            <form method="POST" action="/grupos/<%= g.id %>/toggle">
              <input type="hidden" name="active" value="<%= g.active ? 0 : 1 %>">
              <button class="pill <%= g.active ? 'ok' : 'off' %>"><%= g.active ? 'Sim' : 'Não' %></button>
            </form>
          </td>
          <td class="text-right actions-inline">
            <form method="POST" action="/grupos/<%= g.id %>/delete" data-confirm="Remover este grupo?" data-confirm-title="Remover grupo" data-confirm-text="Remover" data-confirm-danger="true"><button>🗑️</button></form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<script>
(function () {
  const checks = () => Array.from(document.querySelectorAll('.group-check'));
  const all = document.getElementById('group-all');
  const count = document.getElementById('group-count');
  const btn = document.getElementById('btn-delete-selected');
  if (!all || !count || !btn) return;

  function update() {
    const chosen = checks().filter(el => el.checked).length;
    count.textContent = `${chosen} selecionado${chosen === 1 ? '' : 's'}`;
    btn.disabled = !chosen;
    all.checked = chosen > 0 && chosen === checks().length;
    all.indeterminate = chosen > 0 && chosen < checks().length;
  }

  all.addEventListener('change', () => {
    checks().forEach(el => { el.checked = all.checked; });
    update();
  });
  checks().forEach(el => el.addEventListener('change', update));
  update();
})();
</script>

<% if (whatsappEnabled && whatsapp.status !== 'ready') { %>
<script>
  let last = '<%= whatsapp.status %>';
  setInterval(async () => {
    const s = await (await fetch('/api/groups/whatsapp/status')).json();
    if (s.status === 'ready' || s.status !== last) return location.reload();
    const img = document.querySelector('#waQr');
    if (img && s.qr && img.src !== s.qr) img.src = s.qr;
  }, 3000);
</script>
<% } %>
