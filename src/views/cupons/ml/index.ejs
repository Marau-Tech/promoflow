<% page = 'coupons_ml'; %>
<div class="coupons-page">
<div class="page-header">
  <div>
    <h1 class="page-title">Cupons Mercado Livre</h1>
    <p class="page-subtitle">Pega cupons com regras, mínimos, desconto máximo e divulga automático</p>
  </div>
  <div class="header-actions">
    <a class="btn btn-ghost" href="/cupons">← Meus Cupons</a>
    <button class="btn" id="btn-publish-all">Agendar todos (10 por vez)</button>
    <button class="btn btn-primary" id="btn-discover">Buscar cupons ML agora</button>
  </div>
</div>

<section class="card config-card">
  <div class="card-header"><div><h2 class="card-title">Configuração</h2></div></div>
  <div class="card-body">
    <form id="form-cfg" class="form-grid coupons-config">
      <label class="field"><span>Ativo</span><select name="enabled"><option value="true" <%= (config.enabled==='true'||config.enabled===true)?'selected':''%>>Sim</option><option value="false" <%= (config.enabled==='false'||config.enabled===false)?'selected':''%>>Não</option></select></label>
      <label class="field"><span>Divulgar automático</span><select name="auto_publish"><option value="true" <%= (config.auto_publish==='true'||config.auto_publish===true)?'selected':''%>>Sim</option><option value="false" <%= (config.auto_publish==='false'||config.auto_publish===false)?'selected':''%>>Não</option></select></label>
      <label class="field"><span>Intervalo (min)</span><input name="interval_minutes" type="number" value="<%= config.interval_minutes||30 %>"></label>
      <label class="field full"><span>Grupos</span><select name="group_ids" multiple size="3"><% groups.forEach(g=>{%><option value="<%=g.id%>" <%= (config.group_ids||[]).includes(g.id)?'selected':''%>><%=g.name%> (<%=g.platform%>)</option><%})%></select><small class="hint">Sem filtro. Vai publicar tudo que encontrar.</small></label>
      <div class="form-actions full"><button class="btn btn-primary" type="submit">Salvar</button></div>
    </form>
  </div>
</section>

<section class="card coupons-card">
  <div class="card-header">
    <div><h2 class="card-title">Cupons</h2><p class="card-subtitle">Selecione os cupons, escolha os grupos e envie na hora. Até 10 cupons por mensagem.</p></div>
  </div>

  <div class="coupon-sendbar">
    <div class="coupon-groups">
      <span class="coupon-sendbar-label">Grupos de destino</span>
      <div class="group-picker coupon-group-picker">
        <% if (!groups.length) { %>
          <span class="warn">Nenhum grupo cadastrado. <a href="/grupos">Conectar grupos</a></span>
        <% } %>
        <% groups.forEach(g => { %>
          <label class="checkbox"><input type="checkbox" class="couponGroup" value="<%=g.id%>" <%= (config.group_ids||[]).includes(g.id)?'checked':''%>> <%=g.name%> <span class="muted">(<%=g.platform%>)</span></label>
        <% }) %>
      </div>
    </div>
    <div class="coupon-send-actions">
      <span class="badge" id="coupon-count">0 selecionados</span>
      <button class="btn btn-primary" id="btn-send-selected" type="button" disabled>Enviar selecionados</button>
    </div>
  </div>

  <% if (!coupons || !coupons.length) { %>
    <div class="empty"><span>—</span><p>Nenhum cupom encontrado</p><small>Use “Buscar cupons ML agora” para popular a lista.</small></div>
  <% } else { %>
    <div class="table-wrapper">
      <table class="table">
        <thead>
          <tr>
            <th class="coupon-check-col"><input type="checkbox" id="coupon-all" aria-label="Selecionar todos"></th>
            <th>Cupom</th>
            <th>Desconto</th>
            <th>Mínimo</th>
            <th>Máx. desconto</th>
            <th>Regras</th>
            <th>Auto</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% coupons.forEach(c=>{%>
          <tr>
            <td class="coupon-check-col"><input type="checkbox" class="coupon-check" value="<%=c.id%>" aria-label="Selecionar cupom <%=c.code%>"></td>
            <td>
              <strong><%=c.code%></strong>
              <% if (c.queued_at) { %><span class="pill star">Na fila</span><% } %>
              <div class="row-sub"><%=c.title||''%></div>
            </td>
            <td><%= c.discount_type==='percent'? c.discount_value+'% OFF' : 'R$ '+Number(c.discount_value||0).toFixed(2).replace('.',',') %></td>
            <td><%= c.min_purchase? 'R$ '+Number(c.min_purchase).toFixed(2).replace('.',',') : '-'%></td>
            <td><%= c.max_discount? 'R$ '+Number(c.max_discount).toFixed(2).replace('.',',') : '-'%></td>
            <td><div class="rules-text" title="<%=c.rules_text||c.description||''%>"><%=c.rules_text||c.description||'-'%></div></td>
            <td class="auto-cell"><input type="checkbox" class="coupon-auto" data-ap <%= c.auto_publish?'checked':''%> data-id="<%=c.id%>" aria-label="Divulgar automaticamente"></td>
            <td><button class="btn btn-sm btn-primary" data-pub data-id="<%=c.id%>">Enviar</button></td>
          </tr>
          <%})%>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
</div>

<script>
const fmtDate = value => value ? new Date(value).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo', dateStyle: 'short', timeStyle: 'short' }) : '-';

function selectedGroupIds() {
  return Array.from(document.querySelectorAll('.couponGroup:checked')).map(el => Number(el.value)).filter(Boolean);
}

async function askGroups() {
  const picked = selectedGroupIds();
  if (picked.length) return picked;

  const value = await PFUI.prompt({
    title: 'Grupos de envio',
    message: 'Selecione pelo menos um grupo de destino na lista acima ou informe os IDs abaixo.',
    label: 'IDs dos grupos (separados por vírgula)',
    placeholder: '1, 2, 3',
    confirmText: 'Usar grupos',
  });
  if (value === null) return null;
  const ids = value.split(',').map(x => x.trim()).filter(Boolean).map(Number).filter(Boolean);
  return ids.length ? ids : null;
}

document.getElementById('btn-discover').onclick = async () => {
  const b = document.getElementById('btn-discover');
  b.disabled = true;
  b.textContent = 'Buscando...';
  try {
    const r = await fetch('/api/cupons/ml/discover', { method: 'POST' });
    const j = await r.json();
    if (j.error) {
      await PFUI.alert({ title: 'Erro na busca', message: j.error, tone: 'danger' });
      return;
    }

    let msg = `Cupons encontrados: ${j.found || 0}\nNovos/atualizados: ${j.saved || 0}`;
    if (j.batchesScheduled) msg += `\nLotes agendados: ${j.batchesScheduled}`;
    if (j.couponsQueued) msg += `\nCupons no agendamento: ${j.couponsQueued}`;
    if (!j.groupIds) msg += '\n\nNenhum grupo configurado: os cupons foram salvos, mas nada foi agendado.';

    await PFUI.alert({ title: 'Busca concluída', message: msg });
    location.reload();
  } catch (e) {
    await PFUI.alert({ title: 'Erro inesperado', message: e.message, tone: 'danger' });
  } finally {
    b.disabled = false;
    b.textContent = 'Buscar cupons ML agora';
  }
};

document.getElementById('btn-publish-all').onclick = async () => {
  const b = document.getElementById('btn-publish-all');
  const gids = await askGroups();
  if (!gids) return;

  b.disabled = true;
  b.textContent = 'Agendando...';
  try {
    const r = await fetch('/api/cupons/ml/publish-all', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ groupIds: gids }),
    });
    const j = await r.json();
    if (j.ok) {
      await PFUI.alert({
        title: 'Cupons agendados',
        message: `Lotes: ${j.scheduled || 0}\nCupons: ${j.coupons || 0}\nPrimeiro envio: ${fmtDate(j.first)}\nÚltimo envio: ${fmtDate(j.last)}`,
      });
      location.reload();
    } else {
      await PFUI.alert({ title: 'Não foi possível agendar', message: j.error || 'Falha ao agendar os cupons.', tone: 'danger' });
    }
  } catch (e) {
    await PFUI.alert({ title: 'Erro inesperado', message: e.message, tone: 'danger' });
  } finally {
    b.disabled = false;
    b.textContent = 'Agendar todos (10 por vez)';
  }
};

document.getElementById('form-cfg').onsubmit = async e => {
  e.preventDefault();
  const fd = new FormData(e.target);
  const data = {
    enabled: fd.get('enabled'),
    auto_publish: fd.get('auto_publish'),
    interval_minutes: Number(fd.get('interval_minutes')),
    group_ids: Array.from(e.target.querySelector('[name=group_ids]').selectedOptions).map(o => Number(o.value)),
  };

  const r = await fetch('/api/cupons/ml/config', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data),
  });
  const j = await r.json();
  if (!r.ok || j.error) {
    await PFUI.alert({ title: 'Erro ao salvar', message: j.error || 'Não foi possível salvar a configuração.', tone: 'danger' });
    return;
  }
  await PFUI.alert({ title: 'Configuração salva', message: 'As novas configurações já estão valendo.' });
  location.reload();
};

document.querySelectorAll('[data-pub]').forEach(button => {
  button.onclick = async () => {
    const gids = await askGroups();
    if (!gids) return;

    const original = button.textContent;
    button.disabled = true;
    button.textContent = 'Enviando...';
    try {
      const r = await fetch(`/api/cupons/ml/publish/${button.dataset.id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ groupIds: gids }),
      });
      const j = await r.json();
      if (j.ok) {
        await PFUI.alert({ title: 'Cupom enviado', message: 'O cupom foi enviado para os grupos selecionados.' });
        location.reload();
      } else {
        await PFUI.alert({ title: 'Não foi possível enviar', message: j.error || 'Falha ao enviar o cupom.', tone: 'danger' });
      }
    } catch (e) {
      await PFUI.alert({ title: 'Erro inesperado', message: e.message, tone: 'danger' });
    } finally {
      button.disabled = false;
      button.textContent = original;
    }
  };
});

document.querySelectorAll('[data-ap]').forEach(checkbox => {
  checkbox.onchange = async () => {
    const r = await fetch(`/api/cupons/ml/autopublish/${checkbox.dataset.id}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ v: checkbox.checked }),
    });
    if (!r.ok) {
      checkbox.checked = !checkbox.checked;
      await PFUI.alert({ title: 'Erro ao atualizar', message: 'Não foi possível alterar a divulgação automática.', tone: 'danger' });
    }
  };
});

(function initCouponSelection() {
  const checks = () => Array.from(document.querySelectorAll('.coupon-check'));
  const selected = () => checks().filter(el => el.checked);
  const all = document.getElementById('coupon-all');
  const count = document.getElementById('coupon-count');
  const btn = document.getElementById('btn-send-selected');
  if (!count || !btn) return;

  function update() {
    const chosen = selected().length;
    const groups = selectedGroupIds().length;
    count.textContent = `${chosen} selecionado${chosen === 1 ? '' : 's'}`;
    btn.disabled = !chosen || !groups;
    if (all) {
      all.checked = chosen > 0 && chosen === checks().length;
      all.indeterminate = chosen > 0 && chosen < checks().length;
    }
  }

  if (all) {
    all.addEventListener('change', () => {
      checks().forEach(el => { el.checked = all.checked; });
      update();
    });
  }
  checks().forEach(el => el.addEventListener('change', update));
  document.querySelectorAll('.couponGroup').forEach(el => el.addEventListener('change', update));

  btn.addEventListener('click', async () => {
    const couponIds = selected().map(el => Number(el.value)).filter(Boolean);
    const groupIds = selectedGroupIds();
    if (!couponIds.length) {
      await PFUI.alert({ title: 'Selecione os cupons', message: 'Marque pelo menos um cupom para enviar.' });
      return;
    }
    if (!groupIds.length) {
      await PFUI.alert({ title: 'Selecione os grupos', message: 'Marque pelo menos um grupo de destino.' });
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Enviando...';
    try {
      const r = await fetch('/api/cupons/ml/publish-selected', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ couponIds, groupIds }),
      });
      const j = await r.json();
      if (!r.ok || j.error) {
        await PFUI.alert({ title: 'Não foi possível enviar', message: j.error || 'Falha ao enviar os cupons.', tone: 'danger' });
        return;
      }
      let msg = `Cupons enviados: ${j.coupons || 0}\nMensagens: ${j.messages || 0}\nGrupos: ${groupIds.length}`;
      if (j.skipped) msg += `\nJá estavam na fila (ignorados): ${j.skipped}`;
      if (j.failed) msg += `\nFalhas por grupo: ${j.failed}`;
      await PFUI.alert({ title: 'Cupons enviados', message: msg });
      location.reload();
    } catch (e) {
      await PFUI.alert({ title: 'Erro inesperado', message: e.message, tone: 'danger' });
    } finally {
      btn.disabled = false;
      btn.textContent = 'Enviar selecionados';
    }
  });

  update();
})();
</script>
