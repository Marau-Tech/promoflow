<%
  const fmtLog = d => {
    try {
      const s = String(d).replace(' ', 'T');
      return new Date(s).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo', dateStyle: 'short', timeStyle: 'medium' });
    } catch (e) { return d; }
  };
  const paramsFor = (extra = {}) => {
    const f = { ...filters, ...extra };
    const p = new URLSearchParams();
    if (f.level) p.set('level', f.level);
    if (f.category) p.set('category', f.category);
    if (f.q) p.set('q', f.q);
    if (f.from) p.set('from', f.from);
    if (f.to) p.set('to', f.to);
    if (f.limit && Number(f.limit) !== 200) p.set('limit', f.limit);
    const s = p.toString();
    return s ? `?${s}` : '';
  };
  const catCounts = Object.fromEntries((categoryCounts || []).map(c => [c.category, c.count]));
  const levelLabel = { error: 'Erro', warn: 'Aviso', info: 'Info' };
  const levelIcon = { error: '!', warn: '△', info: 'i' };
%>

<div class="page-header">
  <div>
    <h1 class="page-title">Logs &amp; Erros</h1>
    <p class="page-subtitle">Tudo o que acontece no sistema, com filtros por menu, categoria e nível.</p>
  </div>
  <div class="header-actions">
    <a class="btn btn-ghost" href="/logs/export.csv<%= paramsFor() %>">Exportar CSV</a>
    <form method="POST" action="/logs/clear?days=30" data-confirm="Remover logs com mais de 30 dias?" data-confirm-title="Limpar logs" data-confirm-text="Remover" data-confirm-danger="true">
      <button class="btn btn-light">Limpar &gt; 30 dias</button>
    </form>
  </div>
</div>

<div class="stat-grid">
  <div class="stat-card">
    <span class="stat-label">Registros filtrados</span>
    <strong class="stat-value"><%= totalFiltered %></strong>
    <span class="stat-foot">total nas últimas 24h: <%= stats.total %></span>
  </div>
  <div class="stat-card stat-error">
    <span class="stat-label">Erros (24h)</span>
    <strong class="stat-value"><%= stats.error %></strong>
    <span class="stat-foot">falhas que exigem atenção</span>
  </div>
  <div class="stat-card stat-warn">
    <span class="stat-label">Avisos (24h)</span>
    <strong class="stat-value"><%= stats.warn %></strong>
    <span class="stat-foot">comportamentos inesperados</span>
  </div>
  <div class="stat-card stat-info">
    <span class="stat-label">Eventos (24h)</span>
    <strong class="stat-value"><%= stats.info %></strong>
    <span class="stat-foot">ações concluídas com sucesso</span>
  </div>
</div>

<div class="card filter-card">
  <form method="GET" action="/logs" class="logs-filter">
    <div class="filter-row">
      <label class="field grow">
        <span>Buscar</span>
        <input name="q" value="<%= filters.q %>" placeholder="mensagem, origem ou detalhe…">
      </label>
      <label class="field">
        <span>Nível</span>
        <select name="level">
          <option value="">Todos</option>
          <% Object.entries(levels).forEach(([key, label]) => { %>
            <option value="<%= key %>" <%= filters.level === key ? 'selected' : '' %>><%= label %></option>
          <% }) %>
        </select>
      </label>
      <label class="field">
        <span>Categoria / menu</span>
        <select name="category">
          <option value="">Todas</option>
          <% Object.entries(categories).forEach(([key, label]) => { %>
            <option value="<%= key %>" <%= filters.category === key ? 'selected' : '' %>><%= label %><%= catCounts[key] ? ` (${catCounts[key]})` : '' %></option>
          <% }) %>
        </select>
      </label>
      <label class="field">
        <span>De</span>
        <input type="date" name="from" value="<%= filters.from || '' %>">
      </label>
      <label class="field">
        <span>Até</span>
        <input type="date" name="to" value="<%= filters.to || '' %>">
      </label>
      <label class="field">
        <span>Limite</span>
        <select name="limit">
          <% [50, 100, 200, 500, 1000].forEach(n => { %>
            <option value="<%= n %>" <%= Number(filters.limit) === n ? 'selected' : '' %>><%= n %></option>
          <% }) %>
        </select>
      </label>
    </div>
    <div class="filter-actions">
      <a class="btn btn-light" href="/logs">Limpar filtros</a>
      <label class="checkbox boxed"><input type="checkbox" id="autoRefresh"> Atualizar a cada 10s</label>
      <div class="spacer"></div>
      <button class="btn btn-primary" type="submit">Filtrar logs</button>
    </div>
  </form>

  <div class="quick-filters">
    <span class="quick-label">Atalhos:</span>
    <a class="filter-chip <%= filters.level === 'error' && !filters.category ? 'active' : '' %>" href="/logs?level=error">Todos os erros <b><%= stats.error %></b></a>
    <a class="filter-chip <%= filters.category === 'agendamentos' && filters.level === 'error' ? 'active' : '' %>" href="/logs?level=error&category=agendamentos">Erros de agendamento</a>
    <a class="filter-chip <%= filters.category === 'mercadolivre' && filters.level === 'error' ? 'active' : '' %>" href="/logs?level=error&category=mercadolivre">Erros do Mercado Livre</a>
    <a class="filter-chip <%= filters.category === 'whatsapp' && filters.level === 'error' ? 'active' : '' %>" href="/logs?level=error&category=whatsapp">Erros do WhatsApp</a>
    <a class="filter-chip <%= filters.category === 'cupons_ml' && filters.level === 'error' ? 'active' : '' %>" href="/logs?level=error&category=cupons_ml">Erros de cupons</a>
  </div>
</div>

<div class="card logs-card">
  <% if (!logs.length) { %>
    <div class="empty">🛰️
      <p>Nenhum log encontrado</p>
      <small>Assim que o sistema executar ações ou falhar, os registros aparecem aqui.</small>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="logs-table">
        <thead>
          <tr>
            <th>Data/Hora</th>
            <th>Nível</th>
            <th>Menu</th>
            <th>Mensagem</th>
            <th>Origem</th>
          </tr>
        </thead>
        <tbody>
          <% logs.forEach(l => { %>
            <tr class="log-row log-<%= l.level %>">
              <td class="col-date"><%= fmtLog(l.created_at) %></td>
              <td class="col-level">
                <span class="log-level <%= l.level %>"><i><%= levelIcon[l.level] || 'i' %></i><%= levelLabel[l.level] || l.level %></span>
              </td>
              <td class="col-cat">
                <span class="log-cat cat-<%= l.category %>"><%= categories[l.category] || l.category %></span>
              </td>
              <td class="col-message">
                <div class="log-message"><%= l.message %></div>
                <% if (l.details) { %>
                  <details class="log-details-wrap">
                    <summary>Ver detalhes</summary>
                    <pre class="log-details"><%= l.details %></pre>
                  </details>
                <% } %>
              </td>
              <td class="col-source"><code><%= l.source || '—' %></code></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="logs-foot muted small">Exibindo os <%= logs.length %> registros mais recentes de <%= totalFiltered %> encontrados.</p>
  <% } %>
</div>

<script>
  (function () {
    const box = document.getElementById('autoRefresh');
    if (!box) return;
    const on = localStorage.getItem('promoflow:logs-auto') === '1';
    box.checked = on;
    let timer = null;
    if (on) timer = setInterval(() => location.reload(), 10000);
    box.addEventListener('change', () => {
      localStorage.setItem('promoflow:logs-auto', box.checked ? '1' : '0');
      if (timer) clearInterval(timer);
      if (box.checked) timer = setInterval(() => location.reload(), 10000);
    });
  })();
</script>
